{
  "name": "edukit",
  "version": "1.1.0",
  "scripts": {
    "tokens": "node style-dictionary.config.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "deploy-storybook": "gh-pages -d storybook-static",
    "chromatic": "chromatic --exit-zero-on-changes"
  },
  "license": "MIT",
  "description": "EduKit — дизайн-система образовательной платформы (токены W3C, компоненты на HTML/CSS/JS, Storybook)",
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/html-vite": "^10.6.3",
    "gh-pages": "^6.3.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.15.0",
    "storybook": "^10.6.3",
    "style-dictionary": "^5.7.0",
    "vite": "^8.3.5"
  },
  "type": "module",
  "private": true
}
