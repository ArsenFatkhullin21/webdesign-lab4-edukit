{
  "color": {
    "semantic": {
      "background": {
        "default": {
          "$value": "{color.primitive.gray.900}",
          "$type": "color"
        },
        "surface": {
          "$value": "{color.primitive.gray.800}",
          "$type": "color"
        },
        "subtle": {
          "$value": "{color.primitive.gray.800}",
          "$type": "color"
        },
        "overlay": {
          "$value": "rgba(0, 0, 0, 0.7)",
          "$type": "color"
        }
      },
      "text": {
        "default": {
          "$value": "{color.primitive.gray.50}",
          "$type": "color"
        },
        "muted": {
          "$value": "{color.primitive.gray.300}",
          "$type": "color"
        },
        "inverse": {
          "$value": "{color.primitive.gray.900}",
          "$type": "color"
        }
      },
      "border": {
        "default": {
          "$value": "{color.primitive.gray.700}",
          "$type": "color"
        },
        "strong": {
          "$value": "{color.primitive.gray.400}",
          "$type": "color"
        }
      },
      "action": {
        "link": {
          "$value": "{color.primitive.blue.400}",
          "$type": "color"
        },
        "link-hover": {
          "$value": "{color.primitive.blue.200}",
          "$type": "color"
        },
        "primary-soft": {
          "$value": "{color.primitive.blue.900}",
          "$type": "color"
        },
        "danger": {
          "$value": "{color.primitive.red.700}",
          "$type": "color"
        },
        "danger-hover": {
          "$value": "{color.primitive.red.600}",
          "$type": "color"
        }
      },
      "feedback": {
        "info": {
          "bg": {
            "$value": "{color.primitive.blue.900}",
            "$type": "color"
          },
          "text": {
            "$value": "{color.primitive.blue.200}",
            "$type": "color"
          }
        },
        "success": {
          "bg": {
            "$value": "{color.primitive.green.900}",
            "$type": "color"
          },
          "text": {
            "$value": "{color.primitive.green.200}",
            "$type": "color"
          }
        },
        "warning": {
          "bg": {
            "$value": "{color.primitive.amber.900}",
            "$type": "color"
          },
          "text": {
            "$value": "{color.primitive.amber.200}",
            "$type": "color"
          }
        },
        "error": {
          "bg": {
            "$value": "{color.primitive.red.900}",
            "$type": "color"
          },
          "text": {
            "$value": "{color.primitive.red.200}",
            "$type": "color"
          }
        }
      },
      "focus": {
        "ring": {
          "$value": "{color.primitive.blue.400}",
          "$type": "color"
        }
      }
    }
  },
  "shadow": {
    "sm": {
      "$value": {
        "color": "rgba(0, 0, 0, .4)",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "2px",
        "spread": "0px"
      },
      "$type": "shadow"
    },
    "md": {
      "$value": {
        "color": "rgba(0, 0, 0, .5)",
        "offsetX": "0px",
        "offsetY": "4px",
        "blur": "12px",
        "spread": "0px"
      },
      "$type": "shadow"
    },
    "lg": {
      "$value": {
        "color": "rgba(0, 0, 0, .6)",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "24px",
        "spread": "0px"
      },
      "$type": "shadow"
    }
  }
}
